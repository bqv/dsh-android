#!/bin/execlineb

# Run a whole block of device interaction under one lease.
#
#   tools/device 127.0.0.1:5555 .probe/verify.sh
#   tools/device 127.0.0.1:5555 sh -c 'adb -s $SERIAL shell input tap 48 128'
#
# $SERIAL and $ADB are exported for the command.
#
# Why a lease over the whole block, and not a lock per adb command: a verification
# is a *sequence* - install, force-stop, launch, wait, tap, screencap - and a
# per-command lock lets another agent's step land between two of yours. Installing
# force-stops the app, so the other side's screenshots then show a cold start
# instead of the thing under test. That is not hypothetical: the parent's
# lineage-sheet check came back as a full-screen "Loading sessions..." because an
# agent installed a build mid-test.
#
# The lock lives in the checkout, never /tmp: each DSH bash call gets a private
# tmpfs, so a /tmp flock is not a mutex at all (see build.sh and tools/install.sh).
#
# One lock covers every device on purpose. The emulator is the only thing anyone
# should be driving, and the box cannot host a second one: 4 threads at a load
# average of ~14 while one emulator and a Gradle build are running.
#
# This is execline rather than sh because the job is an exec-chain - take a lease,
# then replace ourselves with the command, keeping fd 9 open across the exec. The
# only shell-ish part left is the lock's file name, which is one `tr`.

# ---------------------------------------------------------------- arguments
# execlineb imports this script's argv as positional parameters: 1 is the serial,
# 2..n the command. `shift` drops the serial and `elgetpositionals` then
# substitutes $@ - which must be a standalone word, because that is the only place
# it is split into its separate arguments.
importas -D "" serial 1
shift
elgetpositionals

# The argument count cannot be reached as $#: a bare # starts an execline comment
# and swallows the rest of the line, so it has to be read as a quoted env-var name.
importas -iu sharp "#"

importas -D /opt/android-sdk/platform-tools/adb -u adb ADB
importas -D /home/user/var/work/dsh-android -u root DSH_ANDROID_ROOT
export SERIAL ${serial}
export ADB ${adb}

# The lock is keyed off DSH_ANDROID_ROOT rather than off this script's own $0, so
# that every copy of the tree - including the per-agent checkouts under .work/ -
# leases the same *device*, which is the thing actually being protected. Deriving
# it from the script's location, as the sh version did, gave each copy its own
# lock and therefore no mutex at all.
backtick -E -n lockname { pipeline { printf "%s" ${serial} } /bin/tr -c A-Za-z0-9 _ }

# A missing serial or command is a usage error. The check and the work have to swap
# places, because an execline conditional is terminal: the branch that is taken
# REPLACES the rest of the script, so the whole run has to sit *inside* the branch
# rather than being something the script could come back to.
ifte
  {
    # ------------------------------------------------------------------ lease
    # fd 9 stays open across the exec below. A flock belongs to the open file
    # description rather than to the process that took it, so the lease is held
    # until the command itself exits - the `flock` process comes and goes.
    redirfd -a 9 ${root}/.device-${lockname}.lock

    # execlineb leaves this script's own positional parameters in the environment
    # (0, 1, ...), and importas leaves each name it substitutes under. The sh
    # version leaked neither, so drop our own names here and let emptyenv -P drop
    # the positional ones, which is exactly what that option exists for.
    unexport serial
    unexport sharp
    unexport adb
    unexport root

    ifte
      { emptyenv -P exec $@ }
      {
        foreground { fdmove -c 1 2 /bin/echo "tools/device: another block holds the lease for ${serial}, waiting..." }
        foreground { /usr/bin/flock 9 }
        emptyenv -P exec $@
      }
      /usr/bin/flock -n 9
  }
  { foreground { fdmove -c 1 2 /bin/echo "tools/device: usage: <serial> <command...>" } /bin/false }
  eltest ${sharp} -gt 0
