#!/bin/sh
# One headless Android emulator, in the foreground, for supervise-daemon.
#
# Why this exists: the emulator used to be launched as a child of whatever shell
# or agent job happened to start it, so it died with that job and the device
# silently disappeared mid-verification. Under the OpenRC user service in
# tools/emulator.initd it is started once, supervised, and reachable from any
# later shell.
#
# This deliberately does nothing else, and now it really does nothing else: it
# execs the emulator and that is the entire script. Waiting for the emulator to
# boot, attaching its odd-port transport and reversing the host carrier port are
# all *transport* concerns, and exactly one process owns those: tools/adb-keepalive,
# which is already blocked on adb's device event stream.
#
# Why the background waiter that used to sit at the bottom of this file is gone:
# this script execs, so a `( ... ) &` helper is reparented to the emulator, and
# qemu never calls wait(). Every start therefore left a permanent
# `[emulator-run] <defunct>` zombie, plus its `[adb] <defunct>` child, for the
# whole life of the emulator — visible forever in htop. Moving the work into the
# keepalive removed the waiter rather than repairing it, which is also what this
# file's own argument asked for: a second waiter meant a second poll loop and a
# race with the process that already watches the device list.
set -u

EMU_HOME="${DSH_EMULATOR_HOME:-/home/user/var/work/android-x86-emulator}"
AVD="${DSH_EMULATOR_AVD:-x86native}"
PORT="${DSH_EMULATOR_PORT:-5554}"

export SDK="$EMU_HOME/sdk"
export ANDROID_HOME="$SDK"
export ANDROID_SDK_ROOT="$SDK"
export ANDROID_AVD_HOME="${ANDROID_AVD_HOME:-$HOME/.android/avd}"
export LD_LIBRARY_PATH="$EMU_HOME/libs${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

# Pin one adb client for everything: two different platform-tools versions both
# want to own port 5037, and the resulting server restarts drop live transports.
# (This script no longer calls adb itself; the pin is kept so the emulator cannot
# pick up its own bundled adb through PATH.)
ADB="${ADB:-/opt/android-sdk/platform-tools/adb}"
[ -x "$ADB" ] || ADB="$SDK/platform-tools/adb"
export PATH="$(dirname "$ADB"):$PATH"

# PORT is the *console* port; the adb transport is the odd one beside it
# (5554 -> 5555). tools/adb-keepalive attaches that odd port for every
# `emulator-<port>` it sees reach `device`, and reverses tcp:8081 into it.
exec "$SDK/emulator/emulator" "@$AVD" -no-window -no-audio -no-boot-anim -no-snapshot \
	-accel on -gpu swiftshader_indirect -memory 4096 -cores 4 -port "$PORT"
