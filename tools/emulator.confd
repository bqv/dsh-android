# ~/.config/rc/conf.d/emulator — settings for the user service in
# ~/.config/rc/init.d/emulator.

# Where the AVD, its SDK and its native libs live.
export DSH_EMULATOR_HOME="/home/user/var/work/android-x86-emulator"

# AVD name and console port. The adb serial is derived: emulator-<port>.
export DSH_EMULATOR_AVD="x86native"
export DSH_EMULATOR_PORT="5554"

# adb client to drive the emulator with. Pinned so that the emulator, the
# keepalive in conf.d/adb and every `adb` typed by hand all talk to one server;
# two platform-tools versions fighting over 5037 restart it and drop transports.
export ADB="/opt/android-sdk/platform-tools/adb"
