#!/bin/bash
# One pass of the adb keepalive: adopt whatever is already connected, then follow
# `adb track-devices` until that stream ends.
#
# Driven by tools/adb-keepalive, an execline script that loops this file. This
# script deliberately does NOT loop and contains NO `sleep`: its exit code is the
# instruction to the driver, namely the number of seconds to wait before the next
# pass (see the WAIT_* constants below).
#
# It is bash rather than execline because its job is text and state — decoding a
# length-prefixed binary stream, keeping a set of reversed serials — which is
# exactly what execline does not do. The looping/supervision around it, which
# execline *is* for, lives in tools/adb-keepalive.
#
# Three problems this solves:
#
#  1. adb's server is normally a child of whatever shell started it, so it dies
#     with that shell and the transport drops. Run this as a supervised
#     long-lived process (the OpenRC user service in tools/adb.initd) and plain
#     `adb ...` works from anywhere, across agent sessions and reboots.
#
#  2. Android randomises the wireless-debug port every time Wireless debugging is
#     toggled, so a hard-coded port is always a guess. This asks
#     tools/adb-discover.py instead, and re-discovers whenever the transport drops.
#
#  3. The phone's transport can drop at any moment. This waits on
#     `adb track-devices`, which *streams* transport changes, so a drop is acted
#     on as it happens rather than being noticed up to a poll interval later.
#
# Emulator transports are deliberately out of scope for *disconnection*: they are
# local, they register themselves, and disconnecting one mid-boot removes the
# device from `adb devices` for the rest of the boot. An earlier revision swept
# every non-`device` entry and spent a whole evening kicking emulator-5554.
# An emulator coming up *is* ours to finish, though: the DSH app inside it
# reaches the host carrier through a reversed port, re-applied below.
#
# ADB_PHONE pins a known endpoint and skips discovery; leave it unset to discover.
set -u

ROOT="${DSH_ANDROID_ROOT:-/home/user/var/work/dsh-android}"
export ANDROID_USER_HOME="${ANDROID_USER_HOME:-$ROOT/.toolchain/android-home}"
HOST="${ADB_HOST:-192.168.1.100}"
PINNED="${ADB_PHONE:-}"
DISCOVER="$ROOT/tools/adb-discover.py"

# Exit code == seconds for the driver to wait before the next pass.
WAIT_STREAM_END=2	# normal: track-devices closed on us
WAIT_FLAPPING=10	# stream closed almost immediately -> damp the churn
WAIT_UNREACHABLE=5	# endpoint known, but it did not come up as a device
WAIT_NO_ENDPOINT=30	# discovery found nothing: phone asleep / wireless debug off

mkdir -p "$ANDROID_USER_HOME"

# printf's %(...)T is a bash builtin, so logging does not fork /bin/date. That
# fork was one of the things that made this process look like a crowd in htop.
log() { printf '%(%H:%M:%S)T %s\n' -1 "$*"; }

# Local, self-registering transports. Never ours to disconnect — but an emulator
# coming up *is* ours to finish: the DSH app inside it reaches the host carrier
# through a reversed port, and that reverse has to be re-applied after every
# emulator restart.
is_emulator() {
	case "$1" in
		emulator-*) return 0 ;;
		# The whole emulator port range, even *and* odd. Odd is the adb transport;
		# even is the console, which is not a transport but which adb lists as
		# `offline` once anything has connected to it.
		#
		# Exempting only the odd ones looked tidier and cost a disconnect loop: the
		# console entry came straight back, every device-snapshot event re-dropped
		# it, and the log took five disconnects in eight seconds while the
		# emulator's own helper commands kept regenerating the events. A lingering
		# offline entry is cosmetic; a loop is not.
		localhost:55[0-9][0-9]|127.0.0.1:55[0-9][0-9]) return 0 ;;
		*) return 1 ;;
	esac
}

# The wireless phone transport we are currently following ("" when we have none).
current=""

# Space-delimited set of *emulator* serials whose carrier reverse is currently
# applied. This must be a set, not one "last serial" variable: the running
# emulator registers under BOTH `emulator-5554` and `127.0.0.1:5555`, so a
# one-slot variable lets the two evict each other and re-apply the reverse on
# every single snapshot — an adb-process-per-snapshot feedback loop that ran at
# ~8 reversals/second for hours and is what actually made htop hideous.
reversed=" "
reversed_has() { case "$reversed" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# Space-delimited set of emulator serials whose odd-port transport we have already
# attached, tracked exactly like `reversed` above and for the same reason: a
# restarted emulator must be re-attached, while a steady one must not be attached
# again on every unrelated device event.
attached=" "
attached_has() { case "$attached" in *" $1 "*) return 0 ;; *) return 1 ;; esac; }

# The last full device list we acted on. adb re-sends an *identical* snapshot for
# every unrelated event, and acting on it again costs another `adb devices` + `awk`
# sweep for nothing — 40 of them in 6s under the test stub. Identical repeats are
# dropped here.
last_snapshot=""

# PID of the live `adb track-devices` child. Deliberately a global: bash makes a
# coproc's own NAME_PID local to the function that started it, so an EXIT trap
# referring to TRACK_PID fires on an unset variable once that function returns —
# which, with `set -u`, turned every stop into a crash.
TRACK_CHILD_PID=""

reverse_carrier() {
	# tcp:8081 is the host's carrier port (nginx :80 -> gate :8080 -> carrier).
	adb -s "$1" reverse tcp:8081 tcp:8081 >/dev/null 2>&1 &&
		log "reversed tcp:8081 on $1"
}

# `emulator-<console>` implies its adb transport on the odd port beside it
# (5554 -> 5555). Modern adb no longer scans localhost for emulator ports, so that
# port has to be attached explicitly — tools/device.sh and tools/install.sh pin
# `127.0.0.1:5555` rather than the `emulator-` name.
#
# This used to be a background waiter at the bottom of tools/emulator-run.sh. That
# script execs the emulator, so the waiter was reparented to qemu, which never
# calls wait(): every start left a permanent `[emulator-run.sh] <defunct>` in the
# process table. Attaching here instead puts transport work in the one process
# already watching the device stream — which is what emulator-run.sh's own header
# argued for all along.
attach_odd_port() {
	case "$1" in
		emulator-[0-9]*) ;;
		*) return 1 ;;
	esac
	local console="${1#emulator-}"
	case "$console" in
		''|*[!0-9]*) return 1 ;;
	esac
	# 10# forces decimal: `emulator-0554` must not be read as octal.
	local target="127.0.0.1:$((10#$console + 1))"
	adb connect "$target" >/dev/null 2>&1 &&
		log "attached $target"
}

connected() {
	[ -n "$current" ] || return 1
	adb devices 2>/dev/null | grep -q "^$current[[:space:]]*device"
}

# Serials adb currently reports as usable devices.
device_serials() {
	adb devices 2>/dev/null | awk 'NR>1 && $2 ~ /^device$/ {print $1}'
}

# `track-devices` reports changes, not the current state, so whatever was already
# registered before the stream opened has to be picked up once here — including an
# emulator that booted while this service was restarting.
#
# Read via process substitution rather than `... | while read`: a pipeline runs
# the loop in a subshell, so `current=...` and the `reversed` set were silently
# thrown away. That is why the guard below could never see an adopted phone.
adopt_existing() {
	while read -r serial; do
		[ -n "$serial" ] || continue
		if is_emulator "$serial"; then
			attach_odd_port "$serial" && attached="$attached$serial "
			reverse_carrier "$serial" && reversed="$reversed$serial "
		else
			current="$serial"
			log "already connected $current"
		fi
	done < <(device_serials)
}

# A failed connect can leave an `offline` transport registered, and a leftover
# transport breaks every later bare `adb ...` with "more than one device".
drop_stale_transports() {
	while read -r endpoint; do
		[ -n "$endpoint" ] || continue
		is_emulator "$endpoint" && continue
		[ "$endpoint" = "$current" ] && continue
		adb disconnect "$endpoint" >/dev/null 2>&1
		log "dropped stale transport $endpoint"
	done < <(adb devices 2>/dev/null | awk 'NR>1 && $2 != "device" {print $1}')
}

# Returns 0 connected, 1 endpoint known but not up, 2 nothing to connect to.
reconnect() {
	local candidate=""
	[ -n "$PINNED" ] && candidate="$PINNED"

	if [ -z "$candidate" ] && [ -x "$DISCOVER" ] && command -v python3 >/dev/null 2>&1; then
		candidate=$(python3 "$DISCOVER" --host "$HOST" 2>/dev/null | head -1)
	fi

	if [ -z "$candidate" ]; then
		# Nothing found: the phone is probably asleep, or Wireless debugging is
		# off. The driver backs off 30s so a full port scan does not spin.
		log "no endpoint found"
		return 2
	fi

	adb connect "$candidate" >/dev/null 2>&1
	# `adb connect` returns before the transport has settled, so block on the
	# transport rather than polling `adb devices` until it appears.
	if timeout 15 adb -s "$candidate" wait-for-device >/dev/null 2>&1 &&
		adb devices 2>/dev/null | grep -q "^$candidate[[:space:]]*device"; then
		log "connected $candidate"
		current="$candidate"
		drop_stale_transports
		return 0
	fi

	log "$candidate did not come up as a device"
	adb disconnect "$candidate" >/dev/null 2>&1
	return 1
}

# `adb track-devices` is not a stream of per-device deltas: after a 4-hex-digit
# length it writes the *entire* current device list, `serial<TAB>state` per line.
# So each read is one snapshot, and the phones/emulators in it are reconciled
# against what we last saw. (An earlier revision read the length as if it were its
# own line and then fed the leftover text to `cut`, which is how "16#0032127.0.0.1"
# ended up in the log as an arithmetic error.)
apply_snapshot() {
	# adb re-sends the whole list for every unrelated event, so the common case is
	# a snapshot identical to the one we just handled. Nothing below is worth
	# repeating for that.
	[ "$1" = "$last_snapshot" ] && return 0
	last_snapshot="$1"

	local seen="" new_reversed=" " new_attached=" " serial state
	# A here-document, not a pipe: the loop has to run in this shell so the
	# reconciliation below sees the values it collected.
	while IFS='	' read -r serial state; do
		[ -n "$serial" ] || continue

		if is_emulator "$serial"; then
			# An emulator registering is ours to finish, not ours to drop. Only
			# serials that are actually `device` keep their place in the set, so a
			# restarted emulator gets its reverse re-applied when it comes back —
			# while a steady emulator is never reversed twice.
			if [ "$state" = "device" ]; then
				# Attach the odd-port transport first: the reverse below then lands
				# on the `127.0.0.1:<port>` name too, on the next snapshot.
				if attached_has "$serial" || attach_odd_port "$serial"; then
					new_attached="$new_attached$serial "
				fi
				if reversed_has "$serial" || reverse_carrier "$serial"; then
					new_reversed="$new_reversed$serial "
				fi
			fi
			continue
		fi

		[ "$state" = "device" ] && seen="$serial"
	done <<-EOF
	$1
	EOF
	reversed="$new_reversed"
	attached="$new_attached"

	# Only the wireless transport is ours to follow, and only its changes matter.
	if [ "$seen" != "$current" ]; then
		if [ -n "$seen" ]; then
			log "connected $seen"
		elif [ -n "$current" ]; then
			log "lost $current"
		fi
		current="$seen"
	fi
	[ -n "$current" ] && drop_stale_transports
	return 0
}

# Follow the stream until it ends. The child is owned explicitly — started as a
# coprocess and killed and waited on the way out — because the old `< <(adb
# track-devices)` process substitution was never reaped: every restart left
# another `adb track-devices` reparented to init, and htop had three of them.
follow_track() {
	# `exec` matters for htop: without it the coproc's brace-group runs as a
	# subshell that keeps the *script's* argv, so `ps` showed a second process
	# named `adb-keepalive-pass` next to the real one and `adb track-devices` as
	# its child. exec'ing replaces that subshell, so the child is named honestly.
	coproc TRACK { exec adb track-devices 2>/dev/null; }
	TRACK_CHILD_PID="$TRACK_PID"
	local fd="${TRACK[0]}" header count payload

	# Whatever happens from here on, the child is ours to reap. Note the `:-`:
	# coproc's TRACK_PID dies with this function, so the trap must not depend on it.
	trap 'kill "${TRACK_CHILD_PID:-}" 2>/dev/null' EXIT INT TERM HUP

	while :; do
		# Framing: 4 hex digits of length, then exactly that many bytes.
		#
		# Both reads are bash BUILTINS (`read -N`), which matters twice over:
		#  - no fork, so a snapshot costs zero processes. `$(dd bs=1 ...)` forked
		#    the shell itself once per read, and those transient forks are exactly
		#    what showed up in htop as a flicker of extra `adb-keepalive` entries.
		#  - `read -N` reads exactly N bytes and keeps nothing back, so the header
		#    and its payload cannot desync. The desync this file once hit
		#    ("16#0032127.0.0.1") came from MIXING a shell read with a separate dd
		#    process on the same fd; with a single reader there is no such race.
		# Verified byte-exact over 300 varied records before replacing dd.
		IFS= read -r -N 4 header <&"$fd" || break
		[ ${#header} -eq 4 ] || break
		count=$((16#$header)) 2>/dev/null || break
		IFS= read -r -N "$count" payload <&"$fd" || break
		[ -n "$payload" ] && apply_snapshot "$payload"
	done

	eval "exec ${fd}<&-"
	kill "$TRACK_CHILD_PID" 2>/dev/null
	wait "$TRACK_CHILD_PID" 2>/dev/null
	TRACK_CHILD_PID=""
}

# ---------------------------------------------------------------------------
# One pass.
# ---------------------------------------------------------------------------
SECONDS=0

adb start-server >/dev/null 2>&1
log "adb server up (host=$HOST, pinned=${PINNED:-none})"

adopt_existing
if ! connected; then
	reconnect
	case $? in
		0) : ;;
		2) exit "$WAIT_NO_ENDPOINT" ;;
		*) exit "$WAIT_UNREACHABLE" ;;
	esac
fi

follow_track
log "track-devices ended"

# A stream that closed almost immediately means something upstream is wrong (the
# adb server restarting, the transport flapping). Back off harder than the normal
# 2s so a broken state cannot turn into a hot loop.
if [ "$SECONDS" -lt 5 ]; then
	exit "$WAIT_FLAPPING"
fi
exit "$WAIT_STREAM_END"
