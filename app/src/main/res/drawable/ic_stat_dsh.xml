<?xml version="1.0" encoding="utf-8"?>
<!--
  Status-bar glyph for the standing connection and for attention alerts.
  Notification small icons are drawn as a mask and tinted by the system, so this
  is deliberately single-colour with transparent gaps: the app's two-chevron mark,
  flattened to the 24dp box.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:pathData="M6.5,4.5 L14,12 L6.5,19.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
    <path
        android:pathData="M13,4.5 L20.5,12 L13,19.5"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
