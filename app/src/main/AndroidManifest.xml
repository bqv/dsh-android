<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- An agent that is blocked on an approval or a question must be able to reach
         a pocketed phone; the in-app card alone cannot. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The "Needs attention" channel asks to vibrate, so an approval or a question
         is felt rather than only shown. Install-time permission: no prompt, and
         nothing here vibrates on its own. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The standing connection: a foreground service is the only way to keep the
         event stream open with no Activity, which is what makes an agent's
         approval or question reach a pocketed phone. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:name=".DshApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.DSH">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:theme="@style/Theme.DSH"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Share to DSH. One image, one document, or several at once land in the
                 open session's composer as attachments, which is the same path the +
                 button takes — so a screenshot from the gallery or a PDF from a viewer
                 needs no detour through Downloads.

                 `*/*` on purpose: the app does not care what the file is, and a filter
                 listing only image/* would silently hide "DSH" from a share of
                 anything else. Both actions are registered because a single-file share
                 and a multi-file share are different intents, not a flag. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".DshConnectionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
